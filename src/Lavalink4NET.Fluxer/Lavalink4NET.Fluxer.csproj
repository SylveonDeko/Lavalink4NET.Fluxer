<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <PackageId>Lavalink4NET.Fluxer</PackageId>
    <Version>0.1.1</Version>
    <Authors>SylveonDeko</Authors>
    <Description>Lavalink4NET integration for Fluxer.Net bots, playing Lavalink audio into Fluxer voice channels.</Description>
    <PackageTags>lavalink;lavalink4net;fluxer;music;voice</PackageTags>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/SylveonDeko/Lavalink4NET.Fluxer</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Fluxer.Net.Voice" Version="3.9.0" />
    <PackageReference Include="Lavalink4NET" Version="4.2.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
